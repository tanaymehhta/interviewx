# Copy of the variable NAMES the app needs. This file holds no real values and is safe to commit.
# The real file is `.env.local`. It is never committed. Tanay creates it with `vercel env pull`
# and sends it privately to teammates. On the live site the same variables are set in Vercel.

# --- Supabase (database, sign-in, resume file storage). Required.
NEXT_PUBLIC_SUPABASE_URL=            # project URL; safe to expose to the browser
NEXT_PUBLIC_SUPABASE_ANON_KEY=       # public key; row-level security protects the data
SUPABASE_SERVICE_ROLE_KEY=           # MASTER KEY: bypasses row-level security. Server and scripts only.

# --- OpenRouter (all AI text calls and web search). Required.
OPENROUTER_API_KEY=

# --- AI model selection. Optional; without these the app uses anthropic/claude-haiku-5.5.
AI_MODEL=                            # an OpenRouter model id, e.g. deepseek/deepseek-v4.1-flash
AI_PROVIDER=                         # OpenRouter routing as JSON, e.g. {"zdr":true,"only":["fireworks","together"]}

# --- Fish Audio (the interviewer's voice). Optional; without a key the browser's voice is used.
FISH_API_KEY=
FISH_MODEL=                          # e.g. s2.1-pro-free (the free model)
FISH_VOICE_ID=                       # optional; a Fish Audio voice id. Default voice is "Slax".

# --- Database connection for migrations only (used by `supabase db push`). Tanay only.
POSTGRES_URL_NON_POOLING=
